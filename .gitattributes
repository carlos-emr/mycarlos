# Preserve the source repository's LF text and binary-file handling on Windows.
* text=auto eol=lf
*.png binary
*.ico binary
*.icns binary
*.pdf binary
*.svg text
package-lock.json -diff linguist-generated
*.md diff=markdown

# Preserve upstream snapshots byte-for-byte; review deltas in vendor/*.patch.
src-tauri/vendor/glib/** -text -whitespace linguist-vendored
src-tauri/vendor/tauri/** -text -whitespace linguist-vendored
src-tauri/vendor/*.patch -whitespace
