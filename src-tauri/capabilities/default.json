{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Renderer capabilities for the myCarlos native vault",
  "windows": ["main"],
  "permissions": [
    "allow-runtime-info",
    "allow-kdf-benchmark",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-vault-touch",
    "allow-vault-set-auto-lock",
    "allow-vault-snapshot",
    "allow-vault-change-passphrase",
    "allow-vault-recovery-key-begin",
    "allow-vault-recovery-key-confirm",
    "allow-vault-recovery-kit-save",
    "allow-vault-recovery-key-cancel",
    "allow-vault-recover",
    "allow-vault-backup-pick",
    "allow-vault-backup-picked",
    "allow-vault-restore-pick",
    "allow-vault-restore-inspect",
    "allow-vault-restore",
    "allow-vault-create-profile",
    "allow-vault-create-folder",
    "allow-vault-update-folder",
    "allow-vault-rename-record",
    "allow-vault-assign-folders",
    "allow-vault-assign-folders-batch",
    "allow-vault-import-pick",
    "allow-vault-import-picked",
    "allow-vault-export-pick",
    "allow-vault-export-picked",
    "allow-vault-delete-record",
    "allow-vault-remove-unavailable-records",
    "allow-vault-reset"
  ]
}
