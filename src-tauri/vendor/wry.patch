+// MYCARLOS LOCAL PATCH (#359 PR 7): the policy names the capture types by
+// number so that it needs nothing from WebKit; this ties those numbers to the
+// binding's. A mismatch is a compile error, not a different decision.
+const _: () = {
+  assert!(WKMediaCaptureType::Camera.0 == media_capture_policy::CAMERA);
+  assert!(WKMediaCaptureType::Microphone.0 == media_capture_policy::MICROPHONE);
+  assert!(
+    WKMediaCaptureType::CameraAndMicrophone.0 == media_capture_policy::CAMERA_AND_MICROPHONE
+  );
+};
