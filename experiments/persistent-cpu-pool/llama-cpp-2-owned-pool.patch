+    /// Reuse CPU workers across graphs instead of creating them on every decode.
+    ///
+    /// The pool is private to this context and large enough for both prompt and answer
+    /// thread counts. Repeated calls reuse it. Default native priority, affinity and
+    /// polling remain unchanged. Call only once the calling thread has the restrictions
+    /// the workers should inherit (for example, after entering an application sandbox).
+    /// Returns false for invalid thread counts or failure to allocate the pool.
+    pub fn enable_cpu_threadpool(&mut self) -> bool {
+        if self.cpu_threadpool.is_some() {
+            return true;
+        }
+        self.synchronize();
+        // SAFETY: this exclusively borrowed context is live and synchronized. The native
+        // getters and default-parameter constructor do not retain borrowed Rust storage.
+        let mut params = unsafe {
+            let threads = llama_cpp_sys_2::llama_n_threads(self.context.as_mut_ptr()).max(
+                llama_cpp_sys_2::llama_n_threads_batch(self.context.as_mut_ptr()),
+            );
+            if threads <= 0 {
+                return false;
+            }
+            llama_cpp_sys_2::ggml_threadpool_params_default(threads)
+        };
+        // SAFETY: native construction copies params. We own a successful result until
+        // after llama_free, and never share it with another context.
+        let Some(pool) = NonNull::new(unsafe { llama_cpp_sys_2::ggml_threadpool_new(&mut params) })
+        else {
+            return false;
+        };
+        // SAFETY: llama borrows the live pool. Null batch-pool selects the same pool for
+        // prefill; its capacity covers both thread counts. No context work is in flight.
+        unsafe {
+            llama_cpp_sys_2::llama_attach_threadpool(
+                self.context.as_mut_ptr(),
+                pool.as_ptr(),
+                std::ptr::null_mut(),
+            );
+        }
+        self.cpu_threadpool = Some(pool);
+        true
     }
 
